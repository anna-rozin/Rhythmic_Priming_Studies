#---------------------------------------!-------
# calculate  for 100s 

df_100_scored <- df_100 %>%
  mutate(
    HIT = if_else(
      trial_type == "OFF" & response_perception %in% c("s", "d"),
      1,
      0
    ),
    
    FA = if_else(
      trial_type == "ON" & response_perception %in% c("s", "d"),
      1,
      0
    )
  )

df_100_summary <- df_100_scored %>%
  group_by(subject_nr) %>%
  summarise(
    hits = sum(HIT),
    false_alarms = sum(FA),
    hit_rate = hits / 10,
    fa_rate = false_alarms / 10,
    hit_minus_fa = hit_rate - fa_rate,
    .groups = "drop"
  )

